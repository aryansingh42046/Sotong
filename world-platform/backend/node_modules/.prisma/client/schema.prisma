generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  username          String   @unique
  passwordHash      String?  @map("password_hash")
  googleId          String?  @unique @map("google_id")
  bio               String?
  profilePictureUrl String?  @map("profile_picture_url")
  defaultAvatarId   String?  @map("default_avatar_id")
  emailVerified     Boolean  @default(false) @map("email_verified")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  avatars          Avatar[]
  ownedWorlds      World[]         @relation("WorldOwner")
  worldMemberships WorldMember[]
  sentMessages     Message[]
  sentDMs          DirectMessage[] @relation("DMSender")
  receivedDMs      DirectMessage[] @relation("DMRecipient")
  friendships1     Friendship[]    @relation("FriendUser1")
  friendships2     Friendship[]    @relation("FriendUser2")
  worldSessions    WorldSession[]
  reportsSubmitted Report[]        @relation("Reporter")
  reportsAgainst   Report[]        @relation("ReportedUser")

  @@map("users")
}

model Avatar {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  name           String
  gender         String?
  skinTone       String?  @map("skin_tone")
  hairStyle      String?  @map("hair_style")
  hairColor      String?  @map("hair_color")
  facialFeatures Json?    @map("facial_features")
  clothing       Json?
  accessories    Json?
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  worldSessions WorldSession[]

  @@map("avatars")
}

model World {
  id                   String   @id @default(uuid())
  ownerId              String   @map("owner_id")
  name                 String
  description          String?
  thumbnailUrl         String?  @map("thumbnail_url")
  globePosition        Json?    @map("globe_position")
  globeColor           String?  @map("globe_color")
  worldDesign          Json?    @map("world_design")
  worldCapacity        Int      @default(100) @map("world_capacity")
  mapWidth             Int      @default(100) @map("map_width")
  mapHeight            Int      @default(100) @map("map_height")
  visibility           String   @default("public")
  isPublic             Boolean  @default(true) @map("is_public")
  messageRetentionDays Int      @default(90) @map("message_retention_days")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  owner         User           @relation("WorldOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       WorldMember[]
  roles         Role[]
  rooms         Room[]
  furniture     Furniture[]
  messages      Message[]
  worldSessions WorldSession[]
  reports       Report[]

  @@unique([ownerId, name])
  @@map("worlds")
}

model WorldMember {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  worldId  String   @map("world_id")
  roleId   String?  @map("role_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  role  Role? @relation(fields: [roleId], references: [id])

  @@unique([userId, worldId])
  @@map("world_members")
}

model Role {
  id          String   @id @default(uuid())
  worldId     String   @map("world_id")
  roleName    String   @map("role_name")
  isDefault   Boolean  @default(false) @map("is_default")
  permissions Json?
  createdAt   DateTime @default(now()) @map("created_at")

  world   World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  members WorldMember[]

  @@unique([worldId, roleName])
  @@map("roles")
}

model Room {
  id          String   @id @default(uuid())
  worldId     String   @map("world_id")
  floorNumber Int      @map("floor_number")
  name        String
  positionX   Int?     @map("position_x")
  positionY   Int?     @map("position_y")
  width       Int?
  height      Int?
  roomType    String   @default("chat") @map("room_type")
  isLocked    Boolean  @default(false) @map("is_locked")
  createdAt   DateTime @default(now()) @map("created_at")

  world         World          @relation(fields: [worldId], references: [id], onDelete: Cascade)
  messages      Message[]
  worldSessions WorldSession[]

  @@unique([worldId, floorNumber, name])
  @@map("rooms")
}

model Furniture {
  id                  String   @id @default(uuid())
  worldId             String   @map("world_id")
  floorNumber         Int      @map("floor_number")
  furnitureType       String   @map("furniture_type")
  positionX           Int?     @map("position_x")
  positionY           Int?     @map("position_y")
  rotation            Int      @default(0)
  spriteUrl           String?  @map("sprite_url")
  interactionType     String?  @map("interaction_type")
  interactionMetadata Json?    @map("interaction_metadata")
  createdAt           DateTime @default(now()) @map("created_at")

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@map("furniture")
}

model Message {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  roomId      String?   @map("room_id")
  worldId     String?   @map("world_id")
  content     String
  messageType String    @default("text") @map("message_type")
  isFiltered  Boolean   @default(false) @map("is_filtered")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room    Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  world   World?   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([roomId, createdAt])
  @@index([worldId, createdAt])
  @@index([expiresAt])
  @@map("messages")
}

model Friendship {
  id        String   @id @default(uuid())
  userId1   String   @map("user_id_1")
  userId2   String   @map("user_id_2")
  status    String   @default("pending")
  isMuted   Boolean  @default(false) @map("is_muted")
  createdAt DateTime @default(now()) @map("created_at")

  user1 User @relation("FriendUser1", fields: [userId1], references: [id], onDelete: Cascade)
  user2 User @relation("FriendUser2", fields: [userId2], references: [id], onDelete: Cascade)

  @@unique([userId1, userId2])
  @@map("friendships")
}

model DirectMessage {
  id          String   @id @default(uuid())
  senderId    String   @map("sender_id")
  recipientId String   @map("recipient_id")
  content     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  sender    User @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("DMRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@map("direct_messages")
}

model WorldSession {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  worldId       String   @map("world_id")
  avatarId      String   @map("avatar_id")
  positionX     Float?   @map("position_x")
  positionY     Float?   @map("position_y")
  floorNumber   Int?     @map("floor_number")
  currentRoomId String?  @map("current_room_id")
  sessionToken  String?  @unique @map("session_token")
  joinedAt      DateTime @default(now()) @map("joined_at")
  lastActivity  DateTime @default(now()) @map("last_activity")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  world  World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  avatar Avatar @relation(fields: [avatarId], references: [id])
  room   Room?  @relation(fields: [currentRoomId], references: [id])

  @@index([worldId, floorNumber])
  @@map("world_sessions")
}

model Report {
  id                String   @id @default(uuid())
  reporterId        String   @map("reporter_id")
  reportedUserId    String?  @map("reported_user_id")
  reportedMessageId String?  @map("reported_message_id")
  worldId           String?  @map("world_id")
  reason            String
  status            String   @default("pending")
  createdAt         DateTime @default(now()) @map("created_at")

  reporter        User     @relation("Reporter", fields: [reporterId], references: [id])
  reportedUser    User?    @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reportedMessage Message? @relation(fields: [reportedMessageId], references: [id])
  world           World?   @relation(fields: [worldId], references: [id])

  @@map("reports")
}
